{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"pygments_lexer":"ipython3","nbconvert_exporter":"python","version":"3.6.4","file_extension":".py","codemirror_mode":{"name":"ipython","version":3},"name":"python","mimetype":"text/x-python"},"kaggle":{"accelerator":"none","dataSources":[],"dockerImageVersionId":31286,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"rank_aware_9_experiment_outputs/\n  ## exp1_exact_rank2.csv\n  ## exp3_perturbation.csv\n  ## exp4_rankk_surrogate.csv\n  ## exp5_sketch_qr_scalability.csv\n  ## exp6_benchmark_polynomials.csv\n  ## exp7_method_comparison.csv\n  ## exp8_matrix_pencils.csv\n  ## exp9_failure_ablation.csv\n  ## all_9_experiments.xlsx","metadata":{}},{"cell_type":"code","source":"# rank_aware_9_experiments.py\n\nfrom __future__ import annotations\n\nimport os\nimport time\nimport warnings\nfrom itertools import combinations\nfrom typing import Dict, Tuple, List\n\nimport numpy as np\nimport pandas as pd\n\n\n# ============================================================\n# Global settings\n# ============================================================\n\nOUTPUT_DIR = \"rank_aware_9_experiment_outputs\"\nos.makedirs(OUTPUT_DIR, exist_ok=True)\n\nEPS = 1e-300\nFAIL_TOL = 1e-8\n\n\n# ============================================================\n# Basic polynomial utilities\n# ============================================================\n\ndef poly_eval(coeffs_desc, x):\n    \"\"\"\n    Evaluate a polynomial with descending coefficients.\n    \"\"\"\n    coeffs_desc = np.asarray(coeffs_desc, dtype=complex)\n    return np.polyval(coeffs_desc, x)\n\n\ndef poly_derivative(coeffs_desc):\n    \"\"\"\n    Derivative of a polynomial with descending coefficients.\n    \"\"\"\n    coeffs_desc = np.asarray(coeffs_desc, dtype=complex)\n    n = len(coeffs_desc) - 1\n\n    if n <= 0:\n        return np.array([0.0], dtype=complex)\n\n    return np.array(\n        [coeffs_desc[i] * (n - i) for i in range(n)],\n        dtype=complex\n    )\n\n\ndef stable_power_sum(abs_x, n):\n    \"\"\"\n    Safely compute\n\n        sum_{j=0}^{n} |x|^j.\n\n    This quantity is used to normalize polynomial residuals.\n    \"\"\"\n    abs_x = np.asarray(abs_x, dtype=float)\n    S = np.zeros_like(abs_x, dtype=float)\n\n    close_to_one = np.abs(abs_x - 1.0) < 1e-12\n    S[close_to_one] = n + 1\n\n    mask = ~close_to_one\n\n    with np.errstate(over=\"ignore\", invalid=\"ignore\", divide=\"ignore\"):\n        S[mask] = (abs_x[mask] ** (n + 1) - 1.0) / (abs_x[mask] - 1.0)\n\n    S[~np.isfinite(S)] = np.inf\n    S = np.maximum(S, EPS)\n\n    return S\n\n\ndef backward_error(coeffs_desc, roots):\n    \"\"\"\n    Scale-invariant backward error:\n\n        eta(x) = |f(x)| / (||a(f)||_1 * sum_{j=0}^n |x|^j).\n\n    This is the main accuracy metric. It is more reliable than the raw\n    residual |f(x)| for high-degree polynomials.\n    \"\"\"\n    coeffs_desc = np.asarray(coeffs_desc, dtype=complex)\n    roots = np.asarray(roots, dtype=complex)\n\n    if roots.size == 0:\n        return np.array([np.inf])\n\n    n = len(coeffs_desc) - 1\n    coeff_norm = max(np.sum(np.abs(coeffs_desc)), EPS)\n\n    fx = np.abs(poly_eval(coeffs_desc, roots))\n    scale = coeff_norm * stable_power_sum(np.abs(roots), n)\n\n    eta = fx / np.maximum(scale, EPS)\n    eta[~np.isfinite(eta)] = np.inf\n\n    return eta\n\n\ndef max_backward_error(coeffs_desc, roots):\n    \"\"\"\n    Maximum scale-invariant backward error over all candidate roots.\n    \"\"\"\n    eta = backward_error(coeffs_desc, roots)\n    return float(np.nanmax(eta))\n\n\ndef raw_root_residual(coeffs_desc, roots):\n    \"\"\"\n    Raw residual |f(x)|.\n\n    This is kept only for appendix-level diagnostics because it is scale\n    dependent and can be misleading for high-degree monomial polynomials.\n    \"\"\"\n    roots = np.asarray(roots, dtype=complex)\n\n    if roots.size == 0:\n        return np.inf\n\n    vals = np.abs(poly_eval(coeffs_desc, roots))\n    vals[~np.isfinite(vals)] = np.inf\n\n    return float(np.nanmax(vals))\n\n\ndef normalized_root_residual(coeffs_desc, roots):\n    \"\"\"\n    Normalized residual. This is equivalent to the backward-error scaling\n    and should be used in the main experimental tables instead of raw |f(x)|.\n    \"\"\"\n    return max_backward_error(coeffs_desc, roots)\n\n\ndef newton_refine(coeffs_desc, roots, max_iter=25, tol=1e-12):\n    \"\"\"\n    Newton refinement of candidate roots on the original polynomial.\n    \"\"\"\n    coeffs_desc = np.asarray(coeffs_desc, dtype=complex)\n    roots = np.asarray(roots, dtype=complex).copy()\n\n    if roots.size == 0:\n        return roots\n\n    dcoeffs = poly_derivative(coeffs_desc)\n\n    for _ in range(max_iter):\n        fx = poly_eval(coeffs_desc, roots)\n        dfx = poly_eval(dcoeffs, roots)\n\n        step = np.zeros_like(roots, dtype=complex)\n        valid = np.abs(dfx) > 1e-14\n\n        step[valid] = fx[valid] / dfx[valid]\n        step[~np.isfinite(step)] = 0.0\n\n        new_roots = roots - step\n\n        if np.nanmax(np.abs(new_roots - roots)) < tol:\n            roots = new_roots\n            break\n\n        roots = new_roots\n\n    return roots\n\n\n# ============================================================\n# Structured matrix representation\n# f(x) = C(x)^T A C(x), C(x) = [x^d, ..., 1]^T\n# ============================================================\n\ndef anti_diagonal_poly_from_matrix(A, degree=None):\n    \"\"\"\n    Recover descending polynomial coefficients from A using the corrected\n    anti-diagonal convention:\n\n        f(x) = C(x)^T A C(x),\n        C(x) = [x^d, x^{d-1}, ..., 1]^T.\n\n    If A is m x m, then d = m - 1 and the maximum degree is 2d.\n\n    The coefficient of x^r is recovered from\n\n        a_r = sum_{i+j = 2d-r} A[i,j].\n    \"\"\"\n    A = np.asarray(A, dtype=float)\n    m = A.shape[0]\n    d = m - 1\n    max_degree = 2 * d\n\n    coeffs_desc = np.zeros(max_degree + 1, dtype=float)\n\n    for i in range(m):\n        for j in range(m):\n            power = 2 * d - (i + j)\n            idx = max_degree - power\n            coeffs_desc[idx] += A[i, j]\n\n    if degree is not None:\n        coeffs_desc = coeffs_desc[-(degree + 1):]\n\n    return coeffs_desc\n\n\ndef canonical_A_from_poly(coeffs_desc):\n    \"\"\"\n    Build a canonical symmetric representative A in A(f).\n\n    The coefficient of each power is distributed equally over the\n    corresponding anti-diagonal. This guarantees exact reconstruction under\n    anti_diagonal_poly_from_matrix().\n    \"\"\"\n    coeffs_desc = np.asarray(coeffs_desc, dtype=float)\n    n = len(coeffs_desc) - 1\n\n    d = int(np.ceil(n / 2))\n    m = d + 1\n\n    A = np.zeros((m, m), dtype=float)\n\n    for idx, coeff in enumerate(coeffs_desc):\n        power = n - idx\n        anti_sum = 2 * d - power\n\n        pairs = [\n            (i, j)\n            for i in range(m)\n            for j in range(m)\n            if i + j == anti_sum\n        ]\n\n        if len(pairs) == 0:\n            continue\n\n        share = coeff / len(pairs)\n\n        for i, j in pairs:\n            A[i, j] += share\n\n    return A\n\n\ndef coefficient_mismatch(f_true, f_hat):\n    \"\"\"\n    Relative coefficient reconstruction error:\n\n        ||f - f_hat|| / ||f||.\n    \"\"\"\n    f_true = np.asarray(f_true, dtype=float)\n    f_hat = np.asarray(f_hat, dtype=float)\n\n    max_len = max(len(f_true), len(f_hat))\n\n    a = np.pad(f_true, (max_len - len(f_true), 0))\n    b = np.pad(f_hat, (max_len - len(f_hat), 0))\n\n    return float(np.linalg.norm(a - b) / max(np.linalg.norm(a), EPS))\n\n\n# ============================================================\n# Rank diagnostics\n# ============================================================\n\ndef singular_values(A):\n    \"\"\"\n    Singular values in descending order.\n    \"\"\"\n    return np.linalg.svd(np.asarray(A, dtype=float), compute_uv=False)\n\n\ndef numerical_rank(A, tol=1e-10):\n    \"\"\"\n    Numerical matrix rank using a fixed tolerance.\n    \"\"\"\n    s = singular_values(A)\n    return int(np.sum(s > tol))\n\n\ndef sigma_k(A, k):\n    \"\"\"\n    kth singular value, using 1-based indexing.\n    \"\"\"\n    s = singular_values(A)\n\n    if k <= 0 or k > len(s):\n        return 0.0\n\n    return float(s[k - 1])\n\n\ndef rho_sigma_k(A, k):\n    \"\"\"\n    Spectral rank indicator:\n\n        rho_{sigma,k}(A) = sigma_{k+1}(A) / sigma_1(A).\n    \"\"\"\n    s = singular_values(A)\n\n    if k >= len(s):\n        return 0.0\n\n    return float(s[k] / max(s[0], EPS))\n\n\ndef max_abs_minor(A, size):\n    \"\"\"\n    Maximum absolute minor of a given size.\n\n    For small matrices, this computes exact minors.\n    For large matrices, it uses a singular-value tail proxy to avoid\n    combinatorial explosion.\n    \"\"\"\n    A = np.asarray(A, dtype=float)\n    m = A.shape[0]\n\n    if size > m:\n        return 0.0\n\n    if m > 12:\n        s = singular_values(A)\n        if size - 1 < len(s):\n            return float(np.prod(s[size - 1:]))\n        return 0.0\n\n    best = 0.0\n\n    for I in combinations(range(m), size):\n        for J in combinations(range(m), size):\n            val = abs(np.linalg.det(A[np.ix_(I, J)]))\n            best = max(best, val)\n\n    return float(best)\n\n\n# ============================================================\n# Exact rank-2 polynomial generation\n# ============================================================\n\ndef generate_exact_rank2_polynomial(n, rng):\n    \"\"\"\n    Generate an exact rank-2 collapse polynomial\n\n        f(x) = Q_1(x)^2 - Q_2(x)^2.\n\n    For odd n, the leading term is forced to cancel so that the final\n    polynomial has the requested degree.\n    \"\"\"\n    d = int(np.ceil(n / 2))\n    m = d + 1\n\n    v1 = rng.normal(size=m)\n    v2 = rng.normal(size=m)\n\n    if n % 2 == 1:\n        v2[0] = v1[0]\n\n    A = np.outer(v1, v1) - np.outer(v2, v2)\n\n    coeffs = anti_diagonal_poly_from_matrix(A, degree=n)\n    coeffs = coeffs / max(np.linalg.norm(coeffs), EPS)\n\n    return coeffs, A, v1, v2\n\n\ndef exact_rank2_roots(v1, v2):\n    \"\"\"\n    Recover roots from the exact rank-2 factorization:\n\n        f = (Q_1 - Q_2)(Q_1 + Q_2).\n    \"\"\"\n    roots_plus = np.roots(v1 + v2)\n    roots_minus = np.roots(v1 - v2)\n\n    return np.concatenate([roots_plus, roots_minus])\n\n\n# ============================================================\n# Experiment 1: Exact rank-2 collapse validation\n# ============================================================\n\ndef experiment_1_exact_rank2(degrees=(5, 7, 20, 50), trials=20, seed=1):\n    rng = np.random.default_rng(seed)\n    rows = []\n\n    for n in degrees:\n        for t in range(trials):\n            f, A, v1, v2 = generate_exact_rank2_polynomial(n, rng)\n\n            roots = exact_rank2_roots(v1, v2)\n            roots = roots[:n]\n            roots_ref = newton_refine(f, roots)\n\n           rows.append({\n    \"degree_n\": n,\n    \"trial\": t,\n    \"m\": A.shape[0],\n    \"rank_A\": numerical_rank(A),\n    \"sigma3_A\": sigma_k(A, 3),\n    \"Delta3_A\": max_abs_minor(A, 3),\n    \"eta_max\": max_backward_error(f, roots),\n    \"eta_max_refined\": max_backward_error(f, roots_ref),\n    \"normalized_root_residual\": normalized_root_residual(f, roots_ref),\n    \"raw_root_residual_appendix\": raw_root_residual(f, roots_ref),\n})\n\n    return pd.DataFrame(rows)\n\n\n# ============================================================\n# Experiment 2: Statistical robustness\n# ============================================================\n\ndef experiment_2_statistical_robustness(degrees=(20, 50, 100, 200, 500, 1000), trials=100, seed=2):\n    df = experiment_1_exact_rank2(degrees=degrees, trials=trials, seed=seed)\n\n    summary = df.groupby(\"degree_n\").agg(\n        eta_mean=(\"eta_max_refined\", \"mean\"),\n        eta_std=(\"eta_max_refined\", \"std\"),\n        eta_median=(\"eta_max_refined\", \"median\"),\n        eta_p95=(\"eta_max_refined\", lambda x: np.percentile(x, 95)),\n        eta_worst=(\"eta_max_refined\", \"max\"),\n        failure_rate=(\"eta_max_refined\", lambda x: np.mean(x > FAIL_TOL)),\n        sigma3_median=(\"sigma3_A\", \"median\"),\n        runtime_trials=(\"trial\", \"count\"),\n    ).reset_index()\n\n    return summary\n\n\n# ============================================================\n# Experiment 3: Perturbation and noise stability\n# ============================================================\n\ndef experiment_3_perturbation(degree=50, noise_levels=(1e-12, 1e-10, 1e-8, 1e-6, 1e-4), trials=30, seed=3):\n    rng = np.random.default_rng(seed)\n    rows = []\n\n    for eps in noise_levels:\n        for t in range(trials):\n            f, A, v1, v2 = generate_exact_rank2_polynomial(degree, rng)\n            r = rng.normal(size=len(f))\n            r = r / max(np.linalg.norm(r), EPS)\n\n            f_eps = f + eps * r\n            A_eps = canonical_A_from_poly(f_eps)\n\n            roots_original = exact_rank2_roots(v1, v2)[:degree]\n            roots_eps, runtime = companion_solver(f_eps)\n            roots_eps_ref = newton_refine(f_eps, roots_eps)\n\n            root_drift = np.nan\n            if len(roots_eps_ref) == len(roots_original):\n                root_drift = float(\n                    np.median(\n                        np.sort(np.abs(roots_eps_ref))\n                        - np.sort(np.abs(roots_original))\n                    )\n                )\n\n            rows.append({\n                \"degree_n\": degree,\n                \"epsilon\": eps,\n                \"trial\": t,\n                \"rho_sigma_2\": rho_sigma_k(A_eps, 2),\n                \"Delta3_A\": max_abs_minor(A_eps, 3),\n                \"eta_max_refined\": max_backward_error(f_eps, roots_eps_ref),\n                \"root_drift_median\": abs(root_drift) if np.isfinite(root_drift) else np.nan,\n                \"runtime_s\": runtime,\n                \"detect_rank2\": rho_sigma_k(A_eps, 2) < 1e-8,\n            })\n\n    return pd.DataFrame(rows)\n\n\n# ============================================================\n# Experiment 4: Rank-k surrogate approximation\n# ============================================================\n\ndef experiment_4_rankk_surrogate(degrees=(100, 200, 400, 600, 800), ks=(2, 5, 10, 20, 40), seed=4):\n    rng = np.random.default_rng(seed)\n    rows = []\n\n    for n in degrees:\n        f = rng.normal(size=n + 1)\n        f = f / max(np.linalg.norm(f), EPS)\n        A = canonical_A_from_poly(f)\n\n        for k in ks:\n            if k >= A.shape[0]:\n                continue\n\n            Ak, sketch_time = sketch_qr_rank_k(A, k, oversample=10, seed=seed + n + k)\n            fhat = anti_diagonal_poly_from_matrix(Ak, degree=n)\n\n            roots_hat, root_time = companion_solver(fhat)\n            roots_ref = newton_refine(f, roots_hat)\n\n            rows.append({\n                \"degree_n\": n,\n                \"m\": A.shape[0],\n                \"k\": k,\n                \"rho_sigma_k\": rho_sigma_k(A, k),\n                \"rel_coeff_error\": coefficient_mismatch(f, fhat),\n                \"eta_max\": max_backward_error(f, roots_hat),\n                \"eta_max_refined\": max_backward_error(f, roots_ref),\n                \"root_residual\": root_residual_max(f, roots_ref),\n                \"sketch_time_s\": sketch_time,\n                \"root_time_s\": root_time,\n            })\n\n    return pd.DataFrame(rows)\n\n\n# ============================================================\n# Experiment 5: Sketch-QR scalability and runtime\n# ============================================================\n\ndef experiment_5_sketch_qr_scalability(degrees=(100, 200, 400, 800,1000), k=20, seed=5):\n    rng = np.random.default_rng(seed)\n    rows = []\n\n    for n in degrees:\n        f = rng.normal(size=n + 1)\n        f = f / max(np.linalg.norm(f), EPS)\n        A = canonical_A_from_poly(f)\n\n        start = time.perf_counter()\n        Afull = spectral_rank_k(A, min(k, A.shape[0]))\n        full_time = time.perf_counter() - start\n\n        Asketch, sketch_time = sketch_qr_rank_k(A, min(k, A.shape[0]), oversample=10, seed=seed+n)\n\n        f_full = anti_diagonal_poly_from_matrix(Afull, degree=n)\n        f_sketch = anti_diagonal_poly_from_matrix(Asketch, degree=n)\n\n        rows.append({\n            \"degree_n\": n,\n            \"m\": A.shape[0],\n            \"k\": min(k, A.shape[0]),\n            \"full_eig_time_s\": full_time,\n            \"sketch_qr_time_s\": sketch_time,\n            \"full_coeff_error\": coefficient_mismatch(f, f_full),\n            \"sketch_coeff_error\": coefficient_mismatch(f, f_sketch),\n            \"rho_sigma_k\": rho_sigma_k(A, min(k, A.shape[0])),\n            \"memory_A_MB\": A.nbytes / 1e6,\n        })\n\n    return pd.DataFrame(rows)\n\n\n# ============================================================\n# Experiment 6: Benchmark polynomial comparison\n# ============================================================\n\ndef wilkinson_coeffs(n):\n    return np.poly(np.arange(1, n + 1)).astype(float)\n\n\ndef chebyshev_coeffs(n):\n    from numpy.polynomial.chebyshev import Chebyshev\n    from numpy.polynomial import Polynomial\n\n    T = Chebyshev.basis(n)\n    P = T.convert(kind=Polynomial)\n    return P.coef[::-1].astype(float)\n\n\ndef experiment_6_benchmark_polynomials(degrees=(20, 40, 60, 80, 100), seed=6):\n    rows = []\n\n    for family in [\"Wilkinson\", \"Chebyshev\"]:\n        for n in degrees:\n            try:\n                if family == \"Wilkinson\":\n                    f = wilkinson_coeffs(n)\n                else:\n                    f = chebyshev_coeffs(n)\n\n                f = f / max(np.linalg.norm(f), EPS)\n                A = canonical_A_from_poly(f)\n\n                roots_comp, time_comp = companion_solver(f)\n                roots_comp_ref = newton_refine(f, roots_comp)\n\n                k = min(20, A.shape[0] - 1)\n                Ak, time_sketch = sketch_qr_rank_k(A, k, seed=seed+n)\n                fhat = anti_diagonal_poly_from_matrix(Ak, degree=n)\n\n                roots_rank, time_rank = companion_solver(fhat)\n                roots_rank_ref = newton_refine(f, roots_rank)\n\n                rows.append({\n                    \"family\": family,\n                    \"degree_n\": n,\n                    \"rho_sigma_2\": rho_sigma_k(A, 2),\n                    \"rho_sigma_k\": rho_sigma_k(A, k),\n                    \"k\": k,\n                    \"companion_eta\": max_backward_error(f, roots_comp_ref),\n                    \"rank_eta\": max_backward_error(f, roots_rank_ref),\n                    \"companion_runtime_s\": time_comp,\n                    \"rank_runtime_s\": time_sketch + time_rank,\n                    \"rank_coeff_error\": coefficient_mismatch(f, fhat),\n                })\n\n            except Exception as e:\n                rows.append({\n                    \"family\": family,\n                    \"degree_n\": n,\n                    \"error\": str(e),\n                })\n\n    return pd.DataFrame(rows)\n\n\n# ============================================================\n# Experiment 7: Companion-method comparison\n# ============================================================\n\ndef experiment_7_method_comparison(degrees=(20, 50, 100,500, 1000, 2000), seed=7):\n    rng = np.random.default_rng(seed)\n    rows = []\n\n    methods = {\n        \"companion\": companion_solver,\n        \"fiedler_like\": fiedler_like_baseline,\n        \"durand_kerner\": durand_kerner,\n        \"aberth_ehrlich\": aberth_ehrlich,\n    }\n\n    for n in degrees:\n        f, A, v1, v2 = generate_exact_rank2_polynomial(n, rng)\n\n        # Proposed exact-rank branch\n        start = time.perf_counter()\n        roots_rank = exact_rank2_roots(v1, v2)[:n]\n        roots_rank_ref = newton_refine(f, roots_rank)\n        runtime_rank = time.perf_counter() - start\n\n        rows.append({\n            \"degree_n\": n,\n            \"method\": \"rank-aware exact\",\n            \"eta_max\": max_backward_error(f, roots_rank_ref),\n            \"root_residual\": root_residual_max(f, roots_rank_ref),\n            \"runtime_s\": runtime_rank,\n            \"all_roots\": True,\n            \"requires_initial_guess\": False,\n        })\n\n        for method_name, solver in methods.items():\n            try:\n                roots, runtime = solver(f)\n                roots_ref = newton_refine(f, roots)\n\n                rows.append({\n                    \"degree_n\": n,\n                    \"method\": method_name,\n                    \"eta_max\": max_backward_error(f, roots_ref),\n                    \"root_residual\": root_residual_max(f, roots_ref),\n                    \"runtime_s\": runtime,\n                    \"all_roots\": True,\n                    \"requires_initial_guess\": method_name in [\"durand_kerner\", \"aberth_ehrlich\"],\n                })\n\n            except Exception as e:\n                rows.append({\n                    \"degree_n\": n,\n                    \"method\": method_name,\n                    \"error\": str(e),\n                })\n\n    return pd.DataFrame(rows)\n\n\n# ============================================================\n# Experiment 8: Matrix-pencil eigenvalue validation\n# ============================================================\n\ndef eigenpair_residual_linear(M, eigvals, eigvecs):\n    Mnorm = np.linalg.norm(M, 2)\n    vals = []\n\n    for i, lam in enumerate(eigvals):\n        z = eigvecs[:, i]\n        num = np.linalg.norm((M - lam * np.eye(M.shape[0])) @ z)\n        den = (Mnorm + abs(lam)) * max(np.linalg.norm(z), EPS)\n        vals.append(num / max(den, EPS))\n\n    return float(np.max(vals))\n\n\ndef experiment_8_matrix_pencils(sizes=(50, 100, 200, 500, 1000, 2000), seed=8):\n    rng = np.random.default_rng(seed)\n    rows = []\n\n    for m in sizes:\n        for kind in [\"symmetric\", \"nonnormal\"]:\n            M = rng.normal(size=(m, m))\n            if kind == \"symmetric\":\n                M = (M + M.T) / 2\n\n            start = time.perf_counter()\n            eigvals, eigvecs = np.linalg.eig(M)\n            runtime = time.perf_counter() - start\n\n            rows.append({\n                \"problem\": f\"linear_{kind}\",\n                \"dimension_m\": m,\n                \"pencil_type\": \"linear\",\n                \"max_r_eig\": eigenpair_residual_linear(M, eigvals, eigvecs),\n                \"runtime_s\": runtime,\n            })\n\n    # Quadratic pencil\n    for m in [20, 30, 50]:\n        K = rng.normal(size=(m, m))\n        C = rng.normal(size=(m, m))\n        M = np.eye(m)\n\n        Z = np.zeros((m, m))\n        I = np.eye(m)\n\n        L = np.block([[Z, I], [-K, -C]])\n\n        start = time.perf_counter()\n        eigvals, eigvecs = np.linalg.eig(L)\n        runtime = time.perf_counter() - start\n\n        residuals = []\n        for idx, lam in enumerate(eigvals):\n            z = eigvecs[:m, idx]\n            Pz = (K + lam * C + (lam ** 2) * M) @ z\n            den = (\n                np.linalg.norm(K, 2)\n                + abs(lam) * np.linalg.norm(C, 2)\n                + abs(lam) ** 2 * np.linalg.norm(M, 2)\n            ) * max(np.linalg.norm(z), EPS)\n            residuals.append(np.linalg.norm(Pz) / max(den, EPS))\n\n        rows.append({\n            \"problem\": \"quadratic_random\",\n            \"dimension_m\": m,\n            \"pencil_type\": \"quadratic\",\n            \"max_r_eig\": float(np.max(residuals)),\n            \"runtime_s\": runtime,\n        })\n\n    return pd.DataFrame(rows)\n\n\n# ============================================================\n# Experiment 9: Failure regimes and ablation analysis\n# ============================================================\n\ndef experiment_9_failure_and_ablation(degree=100, seed=9):\n    rng = np.random.default_rng(seed)\n    rows = []\n\n    f = rng.normal(size=degree + 1)\n    f = f / max(np.linalg.norm(f), EPS)\n    A = canonical_A_from_poly(f)\n\n    k = 5\n\n    # Full framework\n    Ak, t_sketch = sketch_qr_rank_k(A, k, oversample=10, seed=seed)\n    fhat = anti_diagonal_poly_from_matrix(Ak, degree=degree)\n    roots, t_root = companion_solver(fhat)\n    roots_ref = newton_refine(f, roots)\n\n    rows.append({\n        \"configuration\": \"full framework\",\n        \"k\": k,\n        \"rel_coeff_error\": coefficient_mismatch(f, fhat),\n        \"eta_max\": max_backward_error(f, roots_ref),\n        \"runtime_s\": t_sketch + t_root,\n        \"rho_sigma_k\": rho_sigma_k(A, k),\n    })\n\n    # Without Newton refinement\n    rows.append({\n        \"configuration\": \"without Newton refinement\",\n        \"k\": k,\n        \"rel_coeff_error\": coefficient_mismatch(f, fhat),\n        \"eta_max\": max_backward_error(f, roots),\n        \"runtime_s\": t_sketch + t_root,\n        \"rho_sigma_k\": rho_sigma_k(A, k),\n    })\n\n    # Without sketch-QR: full spectral truncation\n    start = time.perf_counter()\n    Afull = spectral_rank_k(A, k)\n    t_full = time.perf_counter() - start\n\n    f_full = anti_diagonal_poly_from_matrix(Afull, degree=degree)\n    roots_full, t_root_full = companion_solver(f_full)\n    roots_full_ref = newton_refine(f, roots_full)\n\n    rows.append({\n        \"configuration\": \"full spectral truncation\",\n        \"k\": k,\n        \"rel_coeff_error\": coefficient_mismatch(f, f_full),\n        \"eta_max\": max_backward_error(f, roots_full_ref),\n        \"runtime_s\": t_full + t_root_full,\n        \"rho_sigma_k\": rho_sigma_k(A, k),\n    })\n\n    # Companion fallback on original polynomial\n    roots_comp, t_comp = companion_solver(f)\n    roots_comp_ref = newton_refine(f, roots_comp)\n\n    rows.append({\n        \"configuration\": \"companion fallback\",\n        \"k\": np.nan,\n        \"rel_coeff_error\": 0.0,\n        \"eta_max\": max_backward_error(f, roots_comp_ref),\n        \"runtime_s\": t_comp,\n        \"rho_sigma_k\": np.nan,\n    })\n\n    # Failure case: intentionally too-small rank\n    for bad_k in [1, 2]:\n        Abad, t_bad = sketch_qr_rank_k(A, bad_k, oversample=5, seed=seed+bad_k)\n        f_bad = anti_diagonal_poly_from_matrix(Abad, degree=degree)\n        roots_bad, t_root_bad = companion_solver(f_bad)\n        roots_bad_ref = newton_refine(f, roots_bad)\n\n        rows.append({\n            \"configuration\": f\"failure small rank k={bad_k}\",\n            \"k\": bad_k,\n            \"rel_coeff_error\": coefficient_mismatch(f, f_bad),\n            \"eta_max\": max_backward_error(f, roots_bad_ref),\n            \"runtime_s\": t_bad + t_root_bad,\n            \"rho_sigma_k\": rho_sigma_k(A, bad_k),\n        })\n\n    return pd.DataFrame(rows)\n\n\n# ============================================================\n# Export helper\n# ============================================================\n\ndef save_table(df, name):\n    csv_path = os.path.join(OUTPUT_DIR, f\"{name}.csv\")\n    tex_path = os.path.join(OUTPUT_DIR, f\"{name}.tex\")\n\n    df.to_csv(csv_path, index=False)\n\n    latex = df.to_latex(\n        index=False,\n        escape=False,\n        float_format=lambda x: f\"{x:.3e}\"\n    )\n\n    with open(tex_path, \"w\", encoding=\"utf-8\") as f:\n        f.write(latex)\n\n    return csv_path, tex_path\n\n# ============================================================\n# Main: run all 9 experiments\n# ============================================================\n\ndef run_all_experiments():\n    warnings.filterwarnings(\"ignore\")\n\n    experiments = {\n        \"exp1_exact_rank2\": experiment_1_exact_rank2(),\n        \"exp2_statistical_robustness\": experiment_2_statistical_robustness(),\n        \"exp3_perturbation\": experiment_3_perturbation(),\n        \"exp4_rankk_surrogate\": experiment_4_rankk_surrogate(),\n        \"exp5_sketch_qr_scalability\": experiment_5_sketch_qr_scalability(),\n        \"exp6_benchmark_polynomials\": experiment_6_benchmark_polynomials(),\n        \"exp7_method_comparison\": experiment_7_method_comparison(),\n        \"exp8_matrix_pencils\": experiment_8_matrix_pencils(),\n        \"exp9_failure_ablation\": experiment_9_failure_and_ablation(),\n    }\n\n    with pd.ExcelWriter(os.path.join(OUTPUT_DIR, \"all_9_experiments.xlsx\")) as writer:\n        for name, df in experiments.items():\n            save_table(df, name)\n            df.to_excel(writer, sheet_name=name[:31], index=False)\n\n    print(\"\\nAll 9 experiments completed.\")\n    print(f\"Results saved in: {OUTPUT_DIR}\")\n\n    for name, df in experiments.items():\n        print(\"\\n\" + \"=\" * 80)\n        print(name)\n        print(\"=\" * 80)\n        print(df.head(10).to_string(index=False))\n\n    return experiments\n\n\nif __name__ == \"__main__\":\n    run_all_experiments()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# Figure generation\n# Add this after run_all_experiments()\n# ============================================================\n\nimport matplotlib.pyplot as plt\n\n\nFIG_DIR = os.path.join(OUTPUT_DIR, \"figures\")\nos.makedirs(FIG_DIR, exist_ok=True)\n\n\ndef save_fig(name):\n    path_pdf = os.path.join(FIG_DIR, f\"{name}.pdf\")\n    path_png = os.path.join(FIG_DIR, f\"{name}.png\")\n    plt.tight_layout()\n    plt.savefig(path_pdf, bbox_inches=\"tight\")\n    plt.savefig(path_png, dpi=300, bbox_inches=\"tight\")\n    plt.close()\n    return path_pdf\n\n\ndef plot_exp1_exact_rank2(df):\n    summary = df.groupby(\"degree_n\")[[\"sigma3_A\", \"Delta3_A\", \"eta_max_refined\"]].median()\n\n    plt.figure(figsize=(6, 4))\n    plt.semilogy(summary.index, summary[\"sigma3_A\"], marker=\"o\", label=r\"$\\sigma_3(A)$\")\n    plt.semilogy(summary.index, summary[\"eta_max_refined\"], marker=\"s\", label=r\"$\\eta_{\\max}^{ref}$\")\n    plt.xlabel(\"Polynomial degree\")\n    plt.ylabel(\"Median diagnostic value\")\n    plt.title(\"Exact rank--2 validation\")\n    plt.legend()\n    plt.grid(True, which=\"both\", linestyle=\"--\", linewidth=0.5)\n    save_fig(\"fig_exp1_exact_rank2\")\n\n\ndef plot_exp2_statistical_robustness(df):\n    plt.figure(figsize=(6, 4))\n    plt.errorbar(\n        df[\"degree_n\"],\n        df[\"eta_mean\"],\n        yerr=df[\"eta_std\"],\n        marker=\"o\",\n        capsize=4,\n        label=\"mean ± std\"\n    )\n    plt.yscale(\"log\")\n    plt.xlabel(\"Polynomial degree\")\n    plt.ylabel(r\"Backward error $\\eta_{\\max}$\")\n    plt.title(\"Statistical robustness over random trials\")\n    plt.grid(True, which=\"both\", linestyle=\"--\", linewidth=0.5)\n    plt.legend()\n    save_fig(\"fig_exp2_statistical_robustness\")\n\n\ndef plot_exp3_perturbation(df):\n    summary = df.groupby(\"epsilon\")[[\"eta_max_refined\", \"rho_sigma_2\", \"root_drift_median\"]].median()\n\n    plt.figure(figsize=(6, 4))\n    plt.loglog(summary.index, summary[\"eta_max_refined\"], marker=\"o\", label=r\"$\\eta_{\\max}^{ref}$\")\n    plt.loglog(summary.index, summary[\"rho_sigma_2\"], marker=\"s\", label=r\"$\\rho_{\\sigma,2}$\")\n    plt.xlabel(r\"Noise level $\\epsilon$\")\n    plt.ylabel(\"Median value\")\n    plt.title(\"Perturbation stability\")\n    plt.grid(True, which=\"both\", linestyle=\"--\", linewidth=0.5)\n    plt.legend()\n    save_fig(\"fig_exp3_perturbation_stability\")\n\n\ndef plot_exp4_rankk_surrogate(df):\n    plt.figure(figsize=(6, 4))\n\n    for degree, group in df.groupby(\"degree_n\"):\n        group = group.sort_values(\"k\")\n        plt.semilogy(\n            group[\"k\"],\n            group[\"rel_coeff_error\"],\n            marker=\"o\",\n            label=f\"n={degree}\"\n        )\n\n    plt.xlabel(\"Surrogate rank k\")\n    plt.ylabel(r\"$\\|f-\\widehat f_k\\|/\\|f\\|$\")\n    plt.title(\"Rank--k surrogate approximation quality\")\n    plt.grid(True, which=\"both\", linestyle=\"--\", linewidth=0.5)\n    plt.legend()\n    save_fig(\"fig_exp4_rankk_coeff_error\")\n\n\ndef plot_exp5_runtime(df):\n    plt.figure(figsize=(6, 4))\n    plt.loglog(df[\"degree_n\"], df[\"full_eig_time_s\"], marker=\"o\", label=\"Full eigendecomposition\")\n    plt.loglog(df[\"degree_n\"], df[\"sketch_qr_time_s\"], marker=\"s\", label=\"Sketch--QR\")\n    plt.xlabel(\"Polynomial degree\")\n    plt.ylabel(\"Runtime (s)\")\n    plt.title(\"Runtime scaling\")\n    plt.grid(True, which=\"both\", linestyle=\"--\", linewidth=0.5)\n    plt.legend()\n    save_fig(\"fig_exp5_runtime_scaling\")\n\n\ndef plot_exp6_benchmarks(df):\n    clean = df.dropna(subset=[\"companion_eta\", \"rank_eta\"])\n\n    plt.figure(figsize=(6, 4))\n    for family, group in clean.groupby(\"family\"):\n        group = group.sort_values(\"degree_n\")\n        plt.semilogy(group[\"degree_n\"], group[\"companion_eta\"], marker=\"o\", label=f\"{family} companion\")\n        plt.semilogy(group[\"degree_n\"], group[\"rank_eta\"], marker=\"s\", label=f\"{family} rank-aware\")\n\n    plt.xlabel(\"Polynomial degree\")\n    plt.ylabel(r\"Backward error $\\eta_{\\max}$\")\n    plt.title(\"Benchmark polynomial comparison\")\n    plt.grid(True, which=\"both\", linestyle=\"--\", linewidth=0.5)\n    plt.legend(fontsize=8)\n    save_fig(\"fig_exp6_benchmark_comparison\")\n\n\ndef plot_exp7_method_comparison(df):\n    clean = df.dropna(subset=[\"eta_max\"])\n\n    pivot = clean.groupby(\"method\")[\"eta_max\"].median().sort_values()\n\n    plt.figure(figsize=(7, 4))\n    plt.bar(range(len(pivot)), pivot.values)\n    plt.yscale(\"log\")\n    plt.xticks(range(len(pivot)), pivot.index, rotation=30, ha=\"right\")\n    plt.ylabel(r\"Median $\\eta_{\\max}$\")\n    plt.title(\"Comparison with rootfinding baselines\")\n    plt.grid(True, axis=\"y\", which=\"both\", linestyle=\"--\", linewidth=0.5)\n    save_fig(\"fig_exp7_method_comparison\")\n\n\ndef plot_exp8_matrix_pencils(df):\n    clean = df.dropna(subset=[\"max_r_eig\"])\n\n    plt.figure(figsize=(6, 4))\n    for problem, group in clean.groupby(\"problem\"):\n        group = group.sort_values(\"dimension_m\")\n        plt.semilogy(group[\"dimension_m\"], group[\"max_r_eig\"], marker=\"o\", label=problem)\n\n    plt.xlabel(\"Matrix dimension\")\n    plt.ylabel(r\"Eigenpair residual $r_{\\mathrm{eig}}$\")\n    plt.title(\"Matrix-pencil eigenvalue validation\")\n    plt.grid(True, which=\"both\", linestyle=\"--\", linewidth=0.5)\n    plt.legend(fontsize=8)\n    save_fig(\"fig_exp8_matrix_pencils\")\n\n\ndef plot_exp9_ablation(df):\n    clean = df.dropna(subset=[\"eta_max\"])\n\n    plt.figure(figsize=(7, 4))\n    plt.bar(range(len(clean)), clean[\"eta_max\"])\n    plt.yscale(\"log\")\n    plt.xticks(range(len(clean)), clean[\"configuration\"], rotation=30, ha=\"right\")\n    plt.ylabel(r\"$\\eta_{\\max}$\")\n    plt.title(\"Ablation and failure-regime analysis\")\n    plt.grid(True, axis=\"y\", which=\"both\", linestyle=\"--\", linewidth=0.5)\n    save_fig(\"fig_exp9_ablation\")\n\n\ndef plot_singular_value_decay():\n    rng = np.random.default_rng(123)\n\n    degrees = [50, 100, 200]\n    plt.figure(figsize=(6, 4))\n\n    for n in degrees:\n        f, A, _, _ = generate_exact_rank2_polynomial(n, rng)\n        s = singular_values(A)\n        s = s / max(s[0], EPS)\n        plt.semilogy(np.arange(1, len(s) + 1), s, marker=\"o\", label=f\"n={n}\")\n\n    plt.xlabel(\"Singular-value index\")\n    plt.ylabel(r\"Normalized singular value $\\sigma_i/\\sigma_1$\")\n    plt.title(\"Singular-value decay of structured matrices\")\n    plt.grid(True, which=\"both\", linestyle=\"--\", linewidth=0.5)\n    plt.legend()\n    save_fig(\"fig_singular_value_decay\")\n\n\ndef generate_all_figures(experiments):\n    plot_exp1_exact_rank2(experiments[\"exp1_exact_rank2\"])\n    plot_exp2_statistical_robustness(experiments[\"exp2_statistical_robustness\"])\n    plot_exp3_perturbation(experiments[\"exp3_perturbation\"])\n    plot_exp4_rankk_surrogate(experiments[\"exp4_rankk_surrogate\"])\n    plot_exp5_runtime(experiments[\"exp5_sketch_qr_scalability\"])\n    plot_exp6_benchmarks(experiments[\"exp6_benchmark_polynomials\"])\n    plot_exp7_method_comparison(experiments[\"exp7_method_comparison\"])\n    plot_exp8_matrix_pencils(experiments[\"exp8_matrix_pencils\"])\n    plot_exp9_ablation(experiments[\"exp9_failure_ablation\"])\n    plot_singular_value_decay()\n\n    print(f\"\\nFigures saved in: {FIG_DIR}\")\n\n\n# Replace the final main block with this:\nif __name__ == \"__main__\":\n    experiments = run_all_experiments()\n    generate_all_figures(experiments)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"rank_aware_9_experiment_outputs/figures/\n ### fig_exp1_exact_rank2.pdf\n ### fig_exp2_statistical_robustness.pdf\n  ### fig_exp3_perturbation_stability.pdf\n  ### fig_exp4_rankk_coeff_error.pdf\n ### fig_exp5_runtime_scaling.pdf\n ### fig_exp6_benchmark_comparison.pdf\n  ### fig_exp7_method_comparison.pdf\n###  fig_exp8_matrix_pencils.pdf\n ### fig_exp9_ablation.pdf\n ### fig_singular_value_decay.pdf","metadata":{}},{"cell_type":"markdown","source":"All figures were generated from the same experimental pipeline used to produce\nthe numerical tables. The plots summarize rank diagnostics, perturbation\nstability, surrogate approximation quality, runtime scaling, benchmark\ncomparisons, matrix-pencil residuals, and ablation behavior.","metadata":{}},{"cell_type":"markdown","source":"","metadata":{}},{"cell_type":"markdown","source":"","metadata":{}}]}